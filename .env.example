# Copy to .env (git-ignored) and choose your own password.
POSTGRES_PASSWORD=change-me
# Real PostgreSQL for the PostgreSQL baseline rows (optional; the app works without it).
PG_DSN=postgresql://postgres:change-me@127.0.0.1:55432/carddb
# Optional API protection (required if CARDLAB_HOST is not a loopback address).
# CARDLAB_API_KEY=
# CARDLAB_HOST=127.0.0.1
# CARDLAB_RATE_PER_MIN=60
